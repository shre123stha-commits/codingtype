# dependencies
node_modules/

# builds
dist/

# local runtime data (backend keeps sessions on disk when no cloud link)
backend/data/*.json
!backend/data/.gitkeep
# per-guest session stores — one file per device, never commit anyone's data
backend/data/guests/

# env files — use the platform's env vars (Vercel / Render dashboards) instead
.env
frontend/.env
backend/.env

# debug screenshots from scripts/ (playwright)
.caret-shot.png
.debug-shot.png

# misc
*.log
.DS_Store
