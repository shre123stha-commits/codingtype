# --- Optional: Supabase accounts + cloud data sync -------------------------
# Copy this file to `.env` (frontend/.env) and fill in your project's values
# from the Supabase dashboard:  Project Settings → API
#   - Project URL  → VITE_SUPABASE_URL
#   - anon / public key → VITE_SUPABASE_ANON_KEY   (safe for the browser; RLS protects data)
#
# Leave empty / delete this file to run WITHOUT accounts — the site still
# works fully and all data stays local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: site identity ------------------------------------------------
# Used for canonical / Open Graph / sitemap URLs. Defaults to the production
# domain in src/utils/siteConfig.js if unset.
# VITE_SITE_URL=https://codetype-eight.vercel.app

# Shown on the CONTACT page and used by its mailto form.
# VITE_CONTACT_EMAIL=hello@codetype.dev

# --- Optional: consent-gated analytics --------------------------------------
# Nothing loads unless one of these is set AND the visitor accepts cookies.
#   VITE_ANALYTICS_ID=G-XXXXXXXXXX   → Google Analytics 4
#   VITE_ANALYTICS_ID=plausible      → Plausible (needs VITE_ANALYTICS_DOMAIN)
# VITE_ANALYTICS_ID=
# VITE_ANALYTICS_DOMAIN=

# --- Optional: split deploy --------------------------------------------------
# Where the API lives. Leave unset for same-origin (Vite proxies /api in dev,
# and a single-host deploy needs nothing).
# VITE_API_URL=https://your-app.onrender.com

# NOTE: anything prefixed VITE_ is inlined into the public bundle at build
# time. Never put the Supabase service_role key here — it belongs in
# backend/.env only.
