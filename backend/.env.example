# --- Optional: Supabase (accounts + per-user cloud data) --------------------
# Copy this file to `.env` (backend/.env) and fill in the SAME pair you used
# in frontend/.env — Supabase dashboard:  Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional: leaderboards in the cloud -----------------------------------
# The leaderboard store uses backend/data/leaderboard.json unless BOTH of these
# are set, in which case it uses the public.leaderboard_scores table instead
# (run supabase/migrations/20260830_leaderboards.sql first).
#
# This MUST be the service_role key, and it must live ONLY here — never in
# frontend/.env, never with a VITE_ prefix. Anything VITE_-prefixed is inlined
# into the public JavaScript bundle. The leaderboard table is world-readable by
# design, so if the anon key could write to it, anyone who opened devtools on
# your site could forge a score. anon is given SELECT only for exactly that
# reason.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: ports ---------------------------------------------------------
# PORT=3001

# --- Security ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins (split deploy only).
# Leave empty for the permissive default; set it in production.
# CORS_ORIGIN=https://your-frontend.vercel.app

# Seconds the browser may cache a CORS preflight. Default 600.
# CORS_MAX_AGE=600

# How many proxy hops to trust when deriving the client IP for rate limiting.
# 1 is correct behind a single proxy (Vercel / Render). Set 0 if the API is
# exposed with no proxy in front — otherwise a client can forge
# X-Forwarded-For and walk around every limit.
# TRUST_PROXY=1

# Rate limits, per client IP, per window.
# RATE_LIMIT_WINDOW_MIN=15      # window length
# RATE_LIMIT_MAX=300            # general read bucket
# AUTH_RATE_LIMIT_MAX=5         # account/credential routes (POST /api/waitlist)
# WRITE_RATE_LIMIT_MAX=90       # run persistence (POST /api/sessions)

# Max request body in bytes. Default 1048576 (1 MB).
# MAX_BODY_BYTES=1048576

# Socket timeouts in milliseconds — bound slow/chunked clients.
# REQUEST_TIMEOUT_MS=30000
# HEADERS_TIMEOUT_MS=35000
# KEEP_ALIVE_MS=10000

# Race WebSocket guards.
# WS_MAX_CONNECTIONS_PER_IP=6
# WS_MAX_CREATES_PER_IP=30      # rooms per 15 minutes
# WS_MAX_MESSAGES_PER_MIN=240
