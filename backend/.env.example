# --- Optional: Supabase (accounts + per-user cloud data) --------------------
# Copy this file to `.env` (backend/.env) and fill in the SAME pair you used
# in frontend/.env — Supabase dashboard:  Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional: ports ---------------------------------------------------------
# PORT=3001

# --- Security ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins (split deploy only).
# Leave empty for same-origin (default, most secure).
# CORS_ORIGIN=https://your-frontend.vercel.app

# General API rate limit (requests per client per 15 minutes). Default 300.
# Auth/account routes are fixed at 5 per 15 minutes.
# RATE_LIMIT_MAX=300
